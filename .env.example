# Production site URL. Used for OGP, sitemap, and absolute URL generation.
# Defaults to 'https://example.com' if not set, so the project builds out of the box.
# Set this to your real domain before deploying to production.
PUBLIC_SITE_URL=https://example.com

# Google Analytics 4 Measurement ID (optional).
# If not set, GA4 is not loaded and no analytics scripts are added to the page.
PUBLIC_GA4_ID=

---
// Top navigation bar — kenney.nl style: fixed header, logo left, nav items right, hamburger on mobile.
const { current_page = '/', show_works = true } = Astro.props;

const nav_items = [
  { label: 'Home',  href: '/',         enabled: true },
  { label: 'Comic', href: '/ja/comic/', enabled: true },
  { label: 'Works', href: '/works/',    enabled: show_works },
  { label: 'About', href: '/about/',    enabled: true },
];

const is_active = (href) => current_page === href || (href !== '/' && current_page.startsWith(href));
---

<header class="kn-header">
  <div class="kn-header-inner">
    <button class="kn-hamburger" id="kn-menu-toggle" aria-label="メニューを開く">&#9776;</button>

    <a href="/" class="kn-logo">STUDIO MeowToon</a>

    <nav class="kn-topnav">
      {nav_items.map(item => (
        item.enabled
          ? <a href={item.href} class={`kn-topnav-item ${is_active(item.href) ? 'active' : ''}`}>{item.label}</a>
          : <span class="kn-topnav-item disabled">{item.label}</span>
      ))}
    </nav>
  </div>
</header>

<!-- Mobile sidebar -->
<div class="kn-sidebar" id="kn-sidebar">
  <button class="kn-sidebar-close" id="kn-sidebar-close">&#10005;</button>
  {nav_items.map(item => (
    item.enabled
      ? <a href={item.href} class={`kn-sidebar-item ${is_active(item.href) ? 'active' : ''}`}>{item.label}</a>
      : <span class="kn-sidebar-item disabled">{item.label}</span>
  ))}
</div>
<div class="kn-sidebar-overlay" id="kn-sidebar-overlay"></div>

<style>
  /* ---- Header ---- */
  .kn-header {
    background: var(--md-sys-color-surface);
  }

  .kn-header-inner {
    display: flex;
    align-items: center;
    height: 64px;
    padding: 0 24px;
    max-width: 1400px;
    margin: 0 auto;
    gap: 8px;
  }

  /* ---- Logo ---- */
  .kn-logo {
    font-family: 'Lexend', sans-serif;
    font-size: 18px;
    font-weight: 800;
    color: var(--md-sys-color-on-surface);
    text-decoration: none;
    white-space: nowrap;
    letter-spacing: -0.3px;
    margin-right: 16px;
  }
  .kn-logo:hover { color: var(--md-sys-color-primary); text-decoration: none; }

  /* ---- Desktop nav ---- */
  .kn-topnav {
    display: flex;
    align-items: center;
    gap: 2px;
    flex: 1;
  }

  .kn-topnav-item {
    padding: 8px 16px;
    font-family: 'Noto Sans', sans-serif;
    font-size: 15px;
    font-weight: 800;
    color: var(--md-sys-color-on-surface-variant);
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s;
    white-space: nowrap;
    cursor: pointer;
    border-bottom: 2px solid transparent;
  }
  .kn-topnav-item:hover { color: var(--md-sys-color-on-surface); text-decoration: none; }
  .kn-topnav-item.active { color: var(--md-sys-color-primary); border-bottom-color: var(--md-sys-color-primary); }
  .kn-topnav-item.disabled { opacity: 0.35; cursor: not-allowed; pointer-events: none; }

  /* ---- Hamburger ---- */
  .kn-hamburger {
    display: none;
    background: none;
    border: none;
    font-size: 22px;
    cursor: pointer;
    color: var(--md-sys-color-on-surface);
    padding: 8px;
    line-height: 1;
  }

  /* ---- Mobile sidebar ---- */
  .kn-sidebar {
    position: fixed;
    top: 0; left: -300px; bottom: 0;
    width: 280px;
    background: var(--md-sys-color-surface);
    z-index: 300;
    padding: 72px 12px 24px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    transition: left 0.25s ease;
    box-shadow: var(--md-sys-elevation-level3);
  }
  .kn-sidebar.open { left: 0; }

  .kn-sidebar-close {
    position: absolute;
    top: 14px; left: 14px;
    background: none;
    border: none;
    font-size: 20px;
    cursor: pointer;
    color: var(--md-sys-color-on-surface);
    padding: 8px;
    line-height: 1;
  }

  .kn-sidebar-item {
    display: block;
    padding: 14px 20px;
    border-radius: var(--md-sys-shape-corner-medium);
    font-size: 16px;
    font-weight: 700;
    color: var(--md-sys-color-on-surface-variant);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .kn-sidebar-item:hover { background: var(--md-sys-color-surface-variant); color: var(--md-sys-color-on-surface); text-decoration: none; }
  .kn-sidebar-item.active { background: var(--md-sys-color-secondary-container); color: var(--md-sys-color-primary); }
  .kn-sidebar-item.disabled { opacity: 0.35; cursor: not-allowed; pointer-events: none; }

  .kn-sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.4);
    z-index: 250;
  }
  .kn-sidebar-overlay.open { display: block; }

  /* ---- Mobile breakpoint ---- */
  @media (max-width: 950px) {
    .kn-topnav    { display: none; }
    .kn-hamburger { display: block; margin-right: 8px; }
  }
</style>

<script>
  const toggle  = document.getElementById('kn-menu-toggle');
  const sidebar = document.getElementById('kn-sidebar');
  const overlay = document.getElementById('kn-sidebar-overlay');
  const closeBtn = document.getElementById('kn-sidebar-close');

  const open  = () => { sidebar?.classList.add('open');    overlay?.classList.add('open'); };
  const close = () => { sidebar?.classList.remove('open'); overlay?.classList.remove('open'); };

  toggle?.addEventListener('click', open);
  closeBtn?.addEventListener('click', close);
  overlay?.addEventListener('click', close);
</script>

